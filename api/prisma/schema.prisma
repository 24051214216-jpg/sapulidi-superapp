generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  WARGA
  KOORDINATOR
  BENDAHARA
  KETUA_RT
}

enum UserStatus {
  PENDING
  AKTIF
  DITOLAK
}

enum EventStatus {
  DRAFT
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}

enum AttendanceStatus {
  HADIR
  MENUNGGU_VERIFIKASI
  DITOLAK
  IZIN
  MANUAL
}

enum BudgetStatus {
  DIAJUKAN
  DIREVIEW
  DISETUJUI
  DICAIRKAN
  REALISASI_DILAPORKAN
  SELESAI
  DITOLAK
}

enum CashType {
  MASUK
  KELUAR
}

enum LetterStatus {
  PENDING
  DISETUJUI
  DITOLAK
}

// --- MODELS ---

model Unit {
  id        String   @id @default(uuid())
  blok      String
  nomor     String
  users     User[]
  invoices  Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blok, nomor])
}

model User {
  id           String   @id @default(uuid())
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id])
  nama         String
  noHp         String   @unique
  password     String
  role         Role     @default(WARGA)
  status       UserStatus @default(PENDING)
  
  attendances  Attendance[]
  budgetReqs   BudgetRequest[]
  payments     Payment[]
  letters      LetterRequest[]
  guestLogs    GuestLog[]
  notifications Notification[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  judul       String
  deskripsi   String?
  kategori    String   // "Kerja Bakti", "Ronda", "Sosial", dll
  latCenter   Float
  lngCenter   Float
  radiusM     Int      @default(100)
  mulaiAt     DateTime
  selesaiAt   DateTime
  status      EventStatus @default(DRAFT)
  
  attendances Attendance[]
  budgets     BudgetRequest[]
  loans       AssetLoan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  status      AttendanceStatus @default(MENUNGGU_VERIFIKASI)
  metode      String   @default("Aplikasi") // Aplikasi / Manual
  fotoPath    String?
  lat         Float?
  lng         Float?
  jarakM      Float?
  isMock      Boolean  @default(false)
  waktuAbsen  DateTime @default(now())

  @@unique([eventId, userId])
}

model BudgetRequest {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  judul           String
  totalDiajukan   Float
  status          BudgetStatus @default(DIAJUKAN)
  notaPath        String?  // Bukti LPJ
  totalAktual     Float?
  
  items           BudgetItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BudgetItem {
  id          String @id @default(uuid())
  requestId   String
  request     BudgetRequest @relation(fields: [requestId], references: [id])
  namaItem    String
  qty         Int
  hargaSatuan Float
}

model CashLedger {
  id          String   @id @default(uuid())
  tanggal     DateTime @default(now())
  tipe        CashType
  kategori    String   // "Iuran", "Pencairan Event", "Donasi", dll
  jumlah      Float
  keterangan  String
  refId       String?  // ID dari budget atau invoice
}

model Invoice {
  id        String   @id @default(uuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  periode   String   // "2026-11"
  jumlah    Float
  status    String   @default("BELUM_BAYAR")
  payments  Payment[]
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  buktiPath   String?
  status      String   @default("MENUNGGU")
  createdAt   DateTime @default(now())
}

model LetterRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  jenisSurat  String   // "SKCK", "Domisili", "KTP"
  keperluan   String
  status      LetterStatus @default(PENDING)
  filePdfUrl  String?
  createdAt   DateTime @default(now())
}

model GuestLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  namaTamu    String
  noKtpTamu   String
  hubungan    String
  mulaiMenginap DateTime
  selesaiMenginap DateTime
  createdAt   DateTime @default(now())
}

model Asset {
  id          String   @id @default(uuid())
  namaAset    String
  kondisi     String   @default("BAIK")
  loans       AssetLoan[]
}

model AssetLoan {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  peminjam    String
  tglPinjam   DateTime @default(now())
  tglKembali  DateTime?
  status      String   @default("DIPINJAM")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  judul     String
  pesan     String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}