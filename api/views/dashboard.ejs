<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin SapuLidi</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; padding: 40px; }
        .container { max-width: 900px; margin: 0 auto; background: white; padding: 30px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h1 { color: #2E8B57; margin-bottom: 10px; }
        .cards { display: flex; gap: 20px; margin-top: 30px; }
        .card { flex: 1; background: #e9f5ee; padding: 20px; border-radius: 8px; border-left: 5px solid #2E8B57; }
        .card h3 { margin-top: 0; color: #1f613b; font-size: 16px; }
        .card p { font-size: 24px; font-weight: bold; margin: 10px 0 0 0; color: #333; }
        table { width: 100%; border-collapse: collapse; margin-top: 40px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #2E8B57; color: white; }
        .badge { background: #ffc107; padding: 5px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Dashboard Admin SapuLidi 🧹</h1>
        <p>Selamat datang! Ini adalah halaman Web Admin untuk Ketua RT dan Bendahara.</p>
        
        <div class="cards">
            <div class="card">
                <h3>Data Warga Aktif</h3>
                <p><%= totalWarga %> Orang</p>
            </div>
            <div class="card">
                <h3>Total Kas RT</h3>
                <p>Rp <%= totalKas.toLocaleString('id-ID') %></p>
            </div>
            <div class="card">
                <h3>Total Event</h3>
                <p><%= totalEvent %> Event</p>
            </div>
        </div>

        <h2 style="margin-top: 50px; color: #333;">Menunggu Persetujuan Anggaran</h2>
        <table>
            <thead>
                <tr>
                    <th>Judul Pengajuan</th>
                    <th>Event Terkait</th>
                    <th>Nominal</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if(pengajuanAnggaran.length === 0) { %>
                    <tr><td colspan="5" style="text-align: center;">Tidak ada pengajuan saat ini.</td></tr>
                <% } else { %>
                    <% pengajuanAnggaran.forEach(function(budget) { %>
                        <tr>
                            <td><%= budget.judul %></td>
                            <td><%= budget.event.judul %></td>
                            <td>Rp <%= budget.totalDiajukan.toLocaleString('id-ID') %></td>
                            <td><span class="badge"><%= budget.status %></span></td>
                            <td>
                                <!-- Nanti tombol ini akan kita buat berfungsi -->
                                <button style="cursor:pointer;">Setujui</button>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>