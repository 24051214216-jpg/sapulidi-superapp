generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTH & MULTI-ROLE
// ==========================================
enum Role {
  WARGA
  KETUA_RT
  BENDAHARA
  KOORDINATOR
  PETUGAS_KEAMANAN
}

enum UserStatus {
  PENDING
  AKTIF
  DITOLAK
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  nama          String
  nik           String     @unique @db.VarChar(16)
  noHp          String     @unique
  password      String
  role          Role       @default(WARGA)
  status        UserStatus @default(PENDING)
  fotoProfil    String?    
  blokRumah     String?    
  noRumah       String?    
  rt            String?    @default("05")
  rw            String?    @default("08")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Relations
  attendances   Attendance[]
  invoices      Invoice[]
  payments      Payment[]
  assetLoans    AssetLoan[]
  letters       Letter[]
  guests        Guest[]
  sosRequests   SosRequest[]
  news          News[]
  notifications Notification[]
}

// ==========================================
// 2. EVENT & ABSENSI (GEOTAGGING)
// ==========================================
model Event {
  id            String       @id @default(uuid()) @db.Uuid
  judul         String
  deskripsi     String       @db.Text
  lokasi        String
  latitude      Float?
  longitude     Float?
  mulaiAt       DateTime
  selesaiAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  attendances   Attendance[]
}

model Attendance {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  eventId       String   @db.Uuid
  waktuAbsen    DateTime @default(now())
  latitude      Float
  longitude     Float
  fotoSelfie    String   
  isMocked      Boolean  @default(false) 
  
  user          User     @relation(fields: [userId], references: [id])
  event         Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

// ==========================================
// 3. KEUANGAN (TAGIHAN, PEMBAYARAN, BUKU KAS)
// ==========================================
model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  bulan         Int
  tahun         Int
  totalTagihan  Decimal   @db.Decimal(12, 2)
  status        String    @default("BELUM_BAYAR") 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id])
  payments      Payment[]
}

model Payment {
  id            String    @id @default(uuid()) @db.Uuid
  invoiceId     String    @db.Uuid
  userId        String    @db.Uuid
  jumlah        Decimal   @db.Decimal(12, 2)
  buktiTransfer String    
  status        String    @default("PENDING") 
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

model CashLedger {
  id            String    @id @default(uuid()) @db.Uuid
  tipe          String    
  keterangan    String
  jumlah        Decimal   @db.Decimal(12, 2)
  tanggal       DateTime  @default(now())
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
}

// ==========================================
// 4. INVENTARIS (KATALOG & PEMINJAMAN)
// ==========================================
model Asset {
  id            String      @id @default(uuid()) @db.Uuid
  namaAset      String
  kategori      String
  stokTotal     Int
  stokTersedia  Int
  kondisi       String      @default("BAIK")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  loans         AssetLoan[]
}

model AssetLoan {
  id            String    @id @default(uuid()) @db.Uuid
  assetId       String    @db.Uuid
  userId        String    @db.Uuid
  jumlahPinjam  Int
  tanggalMulai  DateTime
  tanggalSelesai DateTime
  status        String    @default("DIAJUKAN") 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  asset         Asset     @relation(fields: [assetId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

// ==========================================
// 5. ADMINISTRASI (E-SURAT & BUKU TAMU)
// ==========================================
model Letter {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  jenisSurat    String    
  keperluan     String    @db.Text
  status        String    @default("PENDING") 
  qrToken       String?   @unique 
  filePdf       String?   
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id])
}

model Guest {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid 
  namaTamu      String
  nikTamu       String
  hubungan      String
  tglMulai      DateTime
  tglSelesai    DateTime
  status        String    @default("MENGINAP") 
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id])
}

// ==========================================
// 6. SOS DARURAT
// ==========================================
model SosRequest {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  kategori      String    
  latitude      Float
  longitude     Float
  status        String    @default("MENUNGGU") 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
}

// ==========================================
// 7. BERITA & NOTIFIKASI
// ==========================================
model News {
  id            String    @id @default(uuid()) @db.Uuid
  authorId      String    @db.Uuid
  judul         String
  konten        String    @db.Text
  kategori      String
  gambarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  author        User      @relation(fields: [authorId], references: [id])
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  judul         String
  pesan         String    @db.Text
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
}